{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.openazulejos.com"
        }
      ],
      "destination": "https://openazulejos.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "openazulejos.vercel.app"
        }
      ],
      "destination": "https://openazulejos.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "what3world-lisboa.vercel.app"
        }
      ],
      "destination": "https://openazulejos.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/archive",
      "destination": "/api/archive?format=jsonld"
    },
    {
      "source": "/archive/:id",
      "destination": "/api/archive?id=:id&format=jsonld"
    },
    {
      "source": "/observations/:id",
      "destination": "/api/records?history=:id"
    },
    {
      "source": "/iiif/collection",
      "destination": "/api/archive?format=iiif"
    },
    {
      "source": "/iiif/:id/manifest",
      "destination": "/api/archive?id=:id&format=iiif"
    },
    {
      "source": "/lido",
      "destination": "/api/archive?format=lido"
    },
    {
      "source": "/lido/:id",
      "destination": "/api/archive?id=:id&format=lido"
    },
    {
      "source": "/exports/azulejos.geojson",
      "destination": "/api/archive?format=geojson"
    },
    {
      "source": "/exports/azulejos.csv",
      "destination": "/api/archive?format=csv"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(self), microphone=()"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/dashboard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/dashboard.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/dashboard.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/admin-similarity.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/styles-admin-editor.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
